<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="description" content="정보경 ❤ 조효지의 결혼식에 초대합니다">
    <meta property="og:title" content="정보경 ❤ 조효지 결혼식 초대">
    <meta property="og:description" content="2026년 4월 19일 일요일 오후 1시 20분">
    <title>정보경 ❤ 조효지 결혼식 초대</title>
    
    <style>
        /* Google Fonts */
        @import url('https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@300;400;500;600;700&family=Noto+Sans+KR:wght@300;400;500;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap');
        
        /* CSS Variables - 연보라 색상 기반 */
        :root {
            --primary-purple: #9a819b;
            --light-purple: #c4b3c5;
            --lighter-purple: #e8e0e8;
            --pale-purple: #f7f4f7;
            --text-dark: #4a4a4a;
            --text-medium: #6a6a6a;
            --text-light: #8b8b8b;
            --white: #ffffff;
            --shadow: rgba(154, 129, 155, 0.15);
        }
        
        /* Reset & Base */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        html {
            scroll-behavior: smooth;
            -webkit-tap-highlight-color: transparent;
        }
        
        body {
            font-family: 'Noto Sans KR', sans-serif;
            color: var(--text-dark);
            background-color: var(--white);
            overflow-x: hidden;
            line-height: 1.6;
        }
        
        body.no-scroll {
            overflow: hidden;
        }
        
        /* 봉투 컨테이너 */
        .envelope-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, var(--lighter-purple) 0%, var(--pale-purple) 100%);
            z-index: 9999;
            cursor: pointer;
            transition: opacity 0.6s ease, visibility 0.6s ease;
        }
        
        .envelope-container.hidden {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }
        
        .envelope {
            position: relative;
            width: 280px;
            height: 180px;
            perspective: 1000px;
        }
        
        .envelope-body {
            position: absolute;
            width: 100%;
            height: 100%;
            background: var(--white);
            border: 2px solid var(--primary-purple);
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            box-shadow: 0 10px 40px var(--shadow);
        }
        
        .envelope-flap {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 50%;
            background: var(--primary-purple);
            border-radius: 8px 8px 0 0;
            transform-origin: top center;
            transform-style: preserve-3d;
            transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 10;
        }
        
        .envelope-flap::before {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 0;
            border-left: 140px solid transparent;
            border-right: 140px solid transparent;
            border-top: 90px solid var(--primary-purple);
        }
        
        .envelope.opening .envelope-flap {
            transform: rotateX(-180deg);
        }
        
        .tap-text {
            font-family: 'Cormorant Garamond', serif;
            font-size: 24px;
            font-weight: 300;
            font-style: italic;
            color: var(--primary-purple);
            letter-spacing: 3px;
            margin-top: 20px;
            animation: pulse 2s ease-in-out infinite;
        }
        
        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.7; transform: scale(1.05); }
        }
        
        .envelope-heart {
            font-size: 40px;
            color: var(--primary-purple);
            margin-bottom: 10px;
            animation: heartbeat 1.5s ease-in-out infinite;
        }
        
        @keyframes heartbeat {
            0%, 100% { transform: scale(1); }
            25% { transform: scale(1.1); }
            50% { transform: scale(1); }
        }
        
        /* 메인 콘텐츠 */
        .main-content {
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.8s ease 0.3s;
        }
        
        .main-content.visible {
            opacity: 1;
            visibility: visible;
        }
        
        /* 섹션 공통 스타일 */
        .section {
            padding: 60px 20px;
            text-align: center;
        }
        
        .section-title {
            font-family: 'Noto Serif KR', serif;
            font-size: 24px;
            font-weight: 500;
            color: var(--primary-purple);
            margin-bottom: 30px;
            letter-spacing: 1px;
        }
        
        .divider {
            width: 60px;
            height: 2px;
            background: var(--light-purple);
            margin: 40px auto;
        }
        
        /* 메인 헤더 */
        .header-section {
            background: linear-gradient(180deg, var(--pale-purple) 0%, var(--white) 100%);
            padding: 80px 20px 60px;
        }
        
        .main-names {
            font-family: 'Noto Serif KR', serif;
            font-size: 32px;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 20px;
            letter-spacing: 2px;
        }
        
        .heart-symbol {
            color: var(--primary-purple);
            margin: 0 10px;
            font-size: 28px;
        }
        
        .dday-container {
            margin: 30px 0;
            padding: 20px;
            background: var(--white);
            border-radius: 12px;
            box-shadow: 0 4px 20px var(--shadow);
            display: inline-block;
            min-width: 250px;
        }
        
        .dday-text {
            font-size: 16px;
            color: var(--text-medium);
            margin-bottom: 10px;
        }
        
        .dday-count {
            font-family: 'Cormorant Garamond', serif;
            font-size: 48px;
            font-weight: 500;
            color: var(--primary-purple);
            letter-spacing: 2px;
        }
        
        .wedding-date {
            font-size: 18px;
            color: var(--text-medium);
            margin-top: 20px;
            line-height: 1.8;
        }
        
        /* 인사말 섹션 */
        .greeting-section {
            background: var(--white);
        }
        
        .greeting-text {
            font-size: 15px;
            line-height: 1.9;
            color: var(--text-medium);
            margin-bottom: 40px;
            white-space: pre-line;
        }
        
        .parents-info {
            display: flex;
            flex-direction: column;
            gap: 30px;
            margin-top: 40px;
        }
        
        .parent-group {
            font-size: 15px;
            line-height: 1.8;
            color: var(--text-dark);
        }
        
        .parent-label {
            font-weight: 500;
            color: var(--primary-purple);
            margin-bottom: 5px;
        }
        
        /* 예식 정보 */
        .info-section {
            background: var(--pale-purple);
        }
        
        .info-box {
            background: var(--white);
            border-radius: 12px;
            padding: 30px 20px;
            box-shadow: 0 4px 20px var(--shadow);
            max-width: 400px;
            margin: 0 auto;
        }
        
        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid var(--lighter-purple);
        }
        
        .info-row:last-child {
            border-bottom: none;
        }
        
        .info-label {
            font-weight: 500;
            color: var(--primary-purple);
            min-width: 70px;
            text-align: left;
        }
        
        .info-value {
            color: var(--text-dark);
            text-align: right;
            flex: 1;
        }
        
        /* 달력 */
        .calendar-section {
            background: var(--white);
        }
        
        .calendar {
            max-width: 350px;
            margin: 0 auto;
        }
        
        .calendar-header {
            font-family: 'Noto Serif KR', serif;
            font-size: 20px;
            font-weight: 500;
            color: var(--primary-purple);
            margin-bottom: 20px;
        }
        
        .calendar-table {
            width: 100%;
            border-collapse: collapse;
        }
        
        .calendar-table th {
            padding: 12px 5px;
            font-size: 14px;
            font-weight: 500;
            color: var(--text-medium);
        }
        
        .calendar-table th:first-child {
            color: #e57373;
        }
        
        .calendar-table th:last-child {
            color: #64b5f6;
        }
        
        .calendar-table td {
            padding: 10px 5px;
            font-size: 15px;
            color: var(--text-dark);
            text-align: center;
        }
        
        .calendar-table td.empty {
            color: transparent;
        }
        
        .calendar-table td.wedding-day {
            background: var(--primary-purple);
            color: var(--white);
            font-weight: 700;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            position: relative;
        }
        
        /* 갤러리 */
        .gallery-section {
            background: var(--pale-purple);
        }
        
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            max-width: 600px;
            margin: 0 auto;
        }
        
        .gallery-item {
            aspect-ratio: 1 / 1;
            overflow: hidden;
            border-radius: 8px;
            cursor: pointer;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            background: var(--lighter-purple);
        }
        
        .gallery-item:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 20px var(--shadow);
        }
        
        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
        
        /* 갤러리 모달 */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.9);
            z-index: 10000;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        
        .modal.active {
            display: flex;
        }
        
        .modal-image {
            max-width: 90%;
            max-height: 90%;
            object-fit: contain;
            border-radius: 8px;
        }
        
        .modal-close {
            position: absolute;
            top: 20px;
            right: 20px;
            width: 40px;
            height: 40px;
            font-size: 30px;
            color: var(--white);
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            transition: background 0.3s ease;
        }
        
        .modal-close:hover {
            background: rgba(255, 255, 255, 0.3);
        }
        
        /* 오시는 길 */
        .location-section {
            background: var(--white);
        }
        
        .location-address {
            font-size: 16px;
            color: var(--text-dark);
            margin-bottom: 30px;
            line-height: 1.8;
        }
        
        .map-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
        }
        
        .map-btn {
            padding: 14px 30px;
            font-size: 15px;
            font-weight: 500;
            border: 2px solid var(--primary-purple);
            background: var(--white);
            color: var(--primary-purple);
            border-radius: 25px;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-block;
        }
        
        .map-btn:hover {
            background: var(--primary-purple);
            color: var(--white);
        }
        
        /* 계좌번호 */
        .account-section {
            background: var(--pale-purple);
        }
        
        .account-groups {
            display: flex;
            flex-direction: column;
            gap: 30px;
            max-width: 500px;
            margin: 0 auto;
        }
        
        .account-group {
            background: var(--white);
            border-radius: 12px;
            padding: 25px 20px;
            box-shadow: 0 4px 20px var(--shadow);
        }
        
        .account-group-title {
            font-family: 'Noto Serif KR', serif;
            font-size: 18px;
            font-weight: 500;
            color: var(--primary-purple);
            margin-bottom: 20px;
            text-align: center;
        }
        
        .account-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid var(--lighter-purple);
        }
        
        .account-item:last-child {
            border-bottom: none;
        }
        
        .account-info {
            flex: 1;
            text-align: left;
        }
        
        .account-name {
            font-size: 14px;
            font-weight: 500;
            color: var(--text-dark);
            margin-bottom: 4px;
        }
        
        .account-number {
            font-size: 13px;
            color: var(--text-medium);
        }
        
        .copy-btn {
            padding: 8px 16px;
            font-size: 13px;
            border: 1px solid var(--light-purple);
            background: var(--white);
            color: var(--primary-purple);
            border-radius: 15px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .copy-btn:hover {
            background: var(--lighter-purple);
        }
        
        .copy-btn:active {
            transform: scale(0.95);
        }
        
        /* 푸터 */
        .footer-section {
            background: var(--white);
            padding: 40px 20px;
            text-align: center;
            color: var(--text-light);
            font-size: 14px;
        }
        
        .footer-heart {
            color: var(--primary-purple);
            margin: 0 5px;
        }
        
        /* 반응형 */
        @media (max-width: 360px) {
            .main-names {
                font-size: 28px;
            }
            
            .dday-count {
                font-size: 40px;
            }
            
            .section {
                padding: 50px 15px;
            }
            
            .envelope {
                width: 240px;
                height: 150px;
            }
            
            .tap-text {
                font-size: 20px;
            }
        }
        
        @media (min-width: 768px) {
            .section {
                padding: 80px 40px;
            }
            
            .gallery-grid {
                gap: 12px;
            }
        }
    </style>
</head>
<body>
    <!-- 봉투 화면 -->
    <div class="envelope-container" id="envelopeContainer">
        <div class="envelope" id="envelope">
            <div class="envelope-flap"></div>
            <div class="envelope-body">
                <div class="envelope-heart">💜</div>
                <div class="tap-text">TAP TO OPEN</div>
            </div>
        </div>
    </div>

    <!-- 메인 콘텐츠 -->
    <div class="main-content" id="mainContent">
        <!-- 헤더 섹션 -->
        <section class="header-section">
            <h1 class="main-names">
                정보경<span class="heart-symbol">💜</span>조효지
            </h1>
            
            <div class="dday-container">
                <div class="dday-text">결혼식까지</div>
                <div class="dday-count" id="ddayCount">D-DAY</div>
            </div>
            
            <div class="wedding-date">
                2026년 4월 19일 일요일<br>
                오후 1시 20분
            </div>
        </section>

        <!-- 인사말 섹션 -->
        <section class="section greeting-section">
            <h2 class="section-title">소중한 분들을 초대합니다</h2>
            
            <p class="greeting-text">
                서로가 마주보며 다져온 사랑을
                이제 함께 한 곳을 바라보며
                걸어갈 수 있는 큰 사랑으로 키우고자 합니다.

                저희 두 사람이 사랑의 이름으로 지켜나갈
                첫 걸음에 오셔서 축복해 주시면
                감사하겠습니다.
            </p>
            
            <div class="divider"></div>
            
            <div class="parents-info">
                <div class="parent-group">
                    <div class="parent-label">신랑</div>
                    정한국 · 최맹자의 아들 정보경
                </div>
                
                <div class="parent-group">
                    <div class="parent-label">신부</div>
                    조대현 · 정란아의 딸 조효지
                </div>
            </div>
        </section>

        <!-- 예식 정보 섹션 -->
        <section class="section info-section">
            <h2 class="section-title">예식 정보</h2>
            
            <div class="info-box">
                <div class="info-row">
                    <div class="info-label">일시</div>
                    <div class="info-value">2026년 4월 19일 일요일 오후 1:20</div>
                </div>
                <div class="info-row">
                    <div class="info-label">장소</div>
                    <div class="info-value">웨딩그룹위더스 영등포</div>
                </div>
                <div class="info-row">
                    <div class="info-label">주소</div>
                    <div class="info-value">서울 영등포구 영중로 55</div>
                </div>
            </div>
        </section>

        <!-- 달력 섹션 -->
        <section class="section calendar-section">
            <h2 class="section-title">예식 날짜</h2>
            
            <div class="calendar">
                <div class="calendar-header">2026년 4월</div>
                <table class="calendar-table">
                    <thead>
                        <tr>
                            <th>일</th>
                            <th>월</th>
                            <th>화</th>
                            <th>수</th>
                            <th>목</th>
                            <th>금</th>
                            <th>토</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="empty">-</td>
                            <td class="empty">-</td>
                            <td class="empty">-</td>
                            <td>1</td>
                            <td>2</td>
                            <td>3</td>
                            <td>4</td>
                        </tr>
                        <tr>
                            <td>5</td>
                            <td>6</td>
                            <td>7</td>
                            <td>8</td>
                            <td>9</td>
                            <td>10</td>
                            <td>11</td>
                        </tr>
                        <tr>
                            <td>12</td>
                            <td>13</td>
                            <td>14</td>
                            <td>15</td>
                            <td>16</td>
                            <td>17</td>
                            <td>18</td>
                        </tr>
                        <tr>
                            <td class="wedding-day">19</td>
                            <td>20</td>
                            <td>21</td>
                            <td>22</td>
                            <td>23</td>
                            <td>24</td>
                            <td>25</td>
                        </tr>
                        <tr>
                            <td>26</td>
                            <td>27</td>
                            <td>28</td>
                            <td>29</td>
                            <td>30</td>
                            <td class="empty">-</td>
                            <td class="empty">-</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- 갤러리 섹션 -->
        <section class="section gallery-section">
            <h2 class="section-title">Gallery</h2>
            
            <div class="gallery-grid" id="galleryGrid">
                <!-- JavaScript로 1.jpg ~ 20.jpg 생성 -->
            </div>
        </section>

        <!-- 갤러리 모달 -->
        <div class="modal" id="imageModal">
            <div class="modal-close" id="modalClose">×</div>
            <img class="modal-image" id="modalImage" src="" alt="Gallery Image">
        </div>

        <!-- 오시는 길 섹션 -->
        <section class="section location-section">
            <h2 class="section-title">오시는 길</h2>
            
            <div class="location-address">
                웨딩그룹위더스 영등포<br>
                서울 영등포구 영중로 55
            </div>
            
            <div class="map-buttons">
                <a href="https://naver.me/5chuCtRo" target="_blank" class="map-btn">네이버 지도</a>
                <a href="https://place.map.kakao.com/24250591" target="_blank" class="map-btn">카카오맵</a>
            </div>
        </section>

        <!-- 계좌번호 섹션 -->
        <section class="section account-section">
            <h2 class="section-title">마음 전하실 곳</h2>
            
            <div class="account-groups">
                <!-- 신랑측 -->
                <div class="account-group">
                    <div class="account-group-title">신랑측</div>
                    
                    <div class="account-item">
                        <div class="account-info">
                            <div class="account-name">신랑 정보경</div>
                            <div class="account-number">하나은행 620-191216-127</div>
                        </div>
                        <button class="copy-btn" onclick="copyAccount('620-191216-127', '정보경')">복사</button>
                    </div>
                    
                    <div class="account-item">
                        <div class="account-info">
                            <div class="account-name">아버지 정한국</div>
                            <div class="account-number">하나은행 111-111</div>
                        </div>
                        <button class="copy-btn" onclick="copyAccount('111-111', '정한국')">복사</button>
                    </div>
                    
                    <div class="account-item">
                        <div class="account-info">
                            <div class="account-name">어머니 최맹자</div>
                            <div class="account-number">하나은행 111-111</div>
                        </div>
                        <button class="copy-btn" onclick="copyAccount('111-111', '최맹자')">복사</button>
                    </div>
                </div>
                
                <!-- 신부측 -->
                <div class="account-group">
                    <div class="account-group-title">신부측</div>
                    
                    <div class="account-item">
                        <div class="account-info">
                            <div class="account-name">신부 조효지</div>
                            <div class="account-number">농협 123-123-123</div>
                        </div>
                        <button class="copy-btn" onclick="copyAccount('123-123-123', '조효지')">복사</button>
                    </div>
                    
                    <div class="account-item">
                        <div class="account-info">
                            <div class="account-name">아버지 조대현</div>
                            <div class="account-number">농협 111-111</div>
                        </div>
                        <button class="copy-btn" onclick="copyAccount('111-111', '조대현')">복사</button>
                    </div>
                    
                    <div class="account-item">
                        <div class="account-info">
                            <div class="account-name">어머니 정란아</div>
                            <div class="account-number">농협 111-111</div>
                        </div>
                        <button class="copy-btn" onclick="copyAccount('111-111', '정란아')">복사</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- 푸터 -->
        <section class="footer-section">
            Thank you<span class="footer-heart">💜</span><br>
            정보경 & 조효지
        </section>
    </div>

    <script>
        // 봉투 열림 애니메이션
        document.getElementById('envelopeContainer').addEventListener('click', function() {
            const envelope = document.getElementById('envelope');
            const envelopeContainer = document.getElementById('envelopeContainer');
            const mainContent = document.getElementById('mainContent');
            
            // 봉투 열림 애니메이션
            envelope.classList.add('opening');
            
            // 0.8초 후 봉투 컨테이너 숨기기
            setTimeout(() => {
                envelopeContainer.classList.add('hidden');
                mainContent.classList.add('visible');
            }, 800);
        });

        // D-day 카운터
        function updateDday() {
            const weddingDate = new Date('2026-04-19T13:20:00');
            const now = new Date();
            const diff = weddingDate - now;
            
            if (diff > 0) {
                const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                document.getElementById('ddayCount').textContent = `D-${days}`;
            } else if (diff > -86400000) { // 당일 (24시간 이내)
                document.getElementById('ddayCount').textContent = 'D-DAY';
            } else {
                document.getElementById('ddayCount').textContent = 'Thank You';
            }
        }
        
        // 페이지 로드 시 및 1분마다 업데이트
        updateDday();
        setInterval(updateDday, 60000);

        // 갤러리 이미지 생성 (1.jpg ~ 20.jpg)
        function createGallery() {
            const galleryGrid = document.getElementById('galleryGrid');
            
            for (let i = 1; i <= 20; i++) {
                const item = document.createElement('div');
                item.className = 'gallery-item';
                
                const img = document.createElement('img');
                img.src = `/images2/${i}.jpg`;
                img.alt = `Wedding Photo ${i}`;
                img.loading = 'lazy';
                
                // 이미지 로딩 에러 처리
                img.onerror = function() {
                    this.style.background = 'var(--lighter-purple)';
                    this.alt = '이미지 준비중';
                };
                
                item.appendChild(img);
                item.addEventListener('click', () => openModal(`/images2/${i}.jpg`));
                
                galleryGrid.appendChild(item);
            }
        }
        
        createGallery();

        // 갤러리 모달
        function openModal(imageSrc) {
            const modal = document.getElementById('imageModal');
            const modalImage = document.getElementById('modalImage');
            
            modalImage.src = imageSrc;
            modal.classList.add('active');
            document.body.classList.add('no-scroll');
        }
        
        function closeModal() {
            const modal = document.getElementById('imageModal');
            modal.classList.remove('active');
            document.body.classList.remove('no-scroll');
        }
        
        // 모달 닫기 이벤트
        document.getElementById('modalClose').addEventListener('click', closeModal);
        document.getElementById('imageModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeModal();
            }
        });

        // 계좌번호 복사
        function copyAccount(accountNumber, name) {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(accountNumber)
                    .then(() => {
                        alert(`${name}님의 계좌번호가 복사되었습니다.\n${accountNumber}`);
                    })
                    .catch(err => {
                        fallbackCopy(accountNumber, name);
                    });
            } else {
                fallbackCopy(accountNumber, name);
            }
        }
        
        // Clipboard API를 지원하지 않는 경우 대체 방법
        function fallbackCopy(text, name) {
            const textArea = document.createElement('textarea');
            textArea.value = text;
            textArea.style.position = 'fixed';
            textArea.style.opacity = '0';
            document.body.appendChild(textArea);
            textArea.select();
            
            try {
                document.execCommand('copy');
                alert(`${name}님의 계좌번호가 복사되었습니다.\n${text}`);
            } catch (err) {
                alert(`계좌번호: ${text}\n(수동으로 복사해주세요)`);
            }
            
            document.body.removeChild(textArea);
        }

        // ESC 키로 모달 닫기
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeModal();
            }
        });
    </script>
</body>
</html>
